# Core Application Settings
SECRET_KEY=change-me-to-a-secure-random-key
DATABASE_URL=sqlite:///train_reminder.db
DEBUG=False
HOST=127.0.0.1
PORT=5000
BOOKING_WINDOW_DAYS=60
REMINDER_DAYS_BEFORE=1
APPLICATION_NAME=Train Booking Date Reminder System

# PDF Processing & Upload Limits
MAX_CONTENT_LENGTH=10485760
ACADEMIC_CALENDAR_UPLOAD_DIR=instance/uploads/academic_calendars

# Google OAuth Integration (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/google/callback

# Google Calendar Event Policy
GOOGLE_CALENDAR_ID=primary
CALENDAR_EVENT_TIMEZONE=Asia/Kolkata
CALENDAR_EVENT_HOUR=9
